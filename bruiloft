<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Plan van Aanpak – Bruiloft 15 Augustus 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #faf6f0;
    --warm-white: #fffdf9;
    --gold: #b8965a;
    --gold-pale: #f0e4cc;
    --brown: #6b4f2e;
    --text: #2c2018;
    --text-light: #7a6555;
    --border: rgba(184,150,90,0.25);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background-color: var(--cream);
    color: var(--text);
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 14px;
    background-image:
      radial-gradient(ellipse at 15% 20%, rgba(184,150,90,0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 85% 80%, rgba(184,150,90,0.06) 0%, transparent 50%);
  }

  /* ── PRINT BUTTON ── */
  .print-btn {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 100;
    background: var(--text);
    color: var(--gold-pale);
    border: none;
    padding: 10px 20px;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s;
  }
  .print-btn:hover { background: var(--brown); }

  .page-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 48px 40px 80px;
  }

  /* ── HEADER ── */
  header {
    text-align: center;
    padding: 36px 0 28px;
  }
  .ornament {
    display: block;
    font-size: 18px;
    letter-spacing: 10px;
    color: var(--gold);
    margin-bottom: 14px;
    opacity: 0.7;
  }
  header h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 52px;
    line-height: 1.1;
    color: var(--text);
  }
  header h1 em {
    display: block;
    font-style: italic;
    color: var(--gold);
    font-size: 0.55em;
    letter-spacing: 4px;
    margin-top: 4px;
  }
  .date-badge {
    display: inline-block;
    margin-top: 16px;
    padding: 6px 24px;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    font-weight: 400;
  }
  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 28px 0;
    color: var(--gold);
    opacity: 0.5;
  }
  .divider::before, .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--gold);
    opacity: 0.4;
  }

  .intro {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 36px;
    line-height: 1.8;
    color: var(--text-light);
    font-size: 13.5px;
  }

  /* ── SECTIONS ── */
  section {
    margin-bottom: 44px;
  }
  .section-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .section-num {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 12px;
    color: var(--gold);
    letter-spacing: 1px;
    white-space: nowrap;
    opacity: 0.7;
  }
  .section-header h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 22px;
    color: var(--text);
  }
  .section-header::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--gold), transparent);
    opacity: 0.3;
  }

  /* ── PROGRAMMA TIMELINE ── */
  .timeline {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 32px;
  }
  .timeline-col { display: flex; flex-direction: column; }
  .timeline-item {
    display: grid;
    grid-template-columns: 60px 1fr;
    align-items: stretch;
  }
  .timeline-time {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    color: var(--gold);
    padding: 12px 14px 12px 0;
    text-align: right;
    border-right: 1px solid var(--border);
    position: relative;
  }
  .timeline-time::after {
    content: '';
    position: absolute;
    right: -4px;
    top: 50%;
    transform: translateY(-50%);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold-pale);
    border: 1px solid var(--gold);
  }
  .timeline-content {
    padding: 12px 0 12px 16px;
    font-size: 13.5px;
    color: var(--text);
    display: flex;
    align-items: center;
    font-weight: 400;
  }
  .timeline-item:last-child .timeline-time { border-color: transparent; }

  /* ── DRAAIBOEK TABLE ── */
  .table-wrap {
    border: 1px solid var(--border);
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    background: var(--warm-white);
    table-layout: fixed;
  }
  col.col-tijd     { width: 90px; }
  col.col-omschr   { width: 22%; }
  col.col-mensen   { width: 22%; }
  col.col-benod    { width: 22%; }
  col.col-muziek   { width: 22%; }
  thead tr {
    background: var(--text);
    color: var(--gold-pale);
  }
  thead th {
    padding: 10px 12px;
    text-align: left;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  tbody tr { border-bottom: 1px solid var(--border); }
  tbody tr:last-child { border-bottom: none; }
  tbody tr:nth-child(even) { background: rgba(250,246,240,0.6); }
  td {
    padding: 10px 12px;
    vertical-align: top;
    line-height: 1.5;
    color: var(--text);
    word-wrap: break-word;
  }
  td:first-child {
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px;
    color: var(--gold);
    font-weight: 400;
    white-space: nowrap;
  }
  td strong { font-weight: 500; color: var(--brown); }
  td em { font-size: 11px; color: var(--text-light); }

  .music-tag {
    display: inline-block;
    padding: 2px 6px;
    background: var(--gold-pale);
    color: var(--brown);
    font-size: 10px;
    border-radius: 2px;
    margin-top: 2px;
    line-height: 1.4;
  }

  /* ── CHECKLIST ── */
  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0; padding: 0;
  }
  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--text);
  }
  .checklist li input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin-top: 1px;
    border: 1px solid var(--gold);
    border-radius: 2px;
    background: white;
    cursor: pointer;
    position: relative;
    transition: background 0.15s;
  }
  .checklist li input[type="checkbox"]:checked { background: var(--gold); }
  .checklist li input[type="checkbox"]:checked::after {
    content: '✓';
    position: absolute;
    top: -1px; left: 1px;
    font-size: 9px;
    color: white;
    font-weight: 700;
  }
  .checklist li label { cursor: pointer; }
  .checklist li input[type="checkbox"]:checked + label {
    opacity: 0.4;
    text-decoration: line-through;
    text-decoration-color: var(--gold);
  }

  /* ── BENODIGDHEDEN GRID ── */
  .benodigdheden-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .benod-card {
    background: var(--warm-white);
    border: 1px solid var(--border);
    padding: 16px 14px;
    break-inside: avoid;
  }
  .benod-card h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--brown);
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .benod-card h3::before { content: '◆'; font-size: 6px; color: var(--gold); opacity: 0.6; }
  .benod-card ul { list-style: none; display: flex; flex-direction: column; gap: 4px; }
  .benod-card ul li {
    font-size: 12px;
    color: var(--text-light);
    padding-left: 12px;
    position: relative;
    line-height: 1.45;
  }
  .benod-card ul li::before { content: '–'; position: absolute; left: 0; color: var(--gold); opacity: 0.6; }

  /* ── MUZIEK ── */
  .muziek-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 16px;
  }
  .muziek-card {
    background: var(--warm-white);
    border: 1px solid var(--border);
    padding: 12px 14px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    break-inside: avoid;
  }
  .muziek-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
  .muziek-card .moment {
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 3px;
  }
  .muziek-card .song { font-size: 12px; color: var(--text); line-height: 1.4; }

  .playlist-links { display: flex; flex-direction: column; gap: 8px; }
  .playlist-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--warm-white);
    border: 1px solid var(--border);
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .playlist-link:hover { border-color: var(--gold); }
  .pl-icon { font-size: 14px; }
  .pl-name { font-size: 12px; color: var(--text); margin-bottom: 2px; }
  .pl-url { font-size: 10px; color: var(--gold); }

  footer {
    text-align: center;
    padding: 28px 0 16px;
    color: var(--text-light);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.6;
  }
  footer span {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 16px;
    letter-spacing: 0;
    text-transform: none;
    opacity: 1;
    display: block;
    color: var(--gold);
    margin-bottom: 4px;
  }

  /* ── PRINT STYLES ── */
  @media print {
    @page { size: A4; margin: 14mm 14mm 14mm 14mm; }

    .print-btn { display: none !important; }
    body {
      background: white !important;
      background-image: none !important;
      font-size: 10.5pt;
      color: #000;
    }
    .page-wrap { padding: 0; max-width: 100%; }
    header { padding: 12pt 0 10pt; }
    header h1 { font-size: 28pt; }
    .ornament { display: none; }
    .date-badge { border-color: #999; color: #666; font-size: 8pt; padding: 4pt 14pt; }
    .divider { margin: 12pt 0; }
    .intro { font-size: 9pt; margin-bottom: 16pt; color: #444; }
    section { margin-bottom: 18pt; }
    .section-header { margin-bottom: 8pt; }
    .section-header h2 { font-size: 14pt; }
    .section-num { font-size: 9pt; }

    /* Programma: 2 kolommen, compact */
    .timeline { gap: 0 20pt; }
    .timeline-time { font-size: 12pt; padding: 7pt 10pt 7pt 0; }
    .timeline-content { font-size: 10pt; padding: 7pt 0 7pt 12pt; }

    /* Draaiboek tabel */
    .table-wrap { border: 0.5pt solid #ccc; }
    table { font-size: 8pt; }
    col.col-tijd   { width: 56pt; }
    col.col-omschr { width: auto; }
    col.col-mensen { width: auto; }
    col.col-benod  { width: auto; }
    col.col-muziek { width: auto; }
    thead tr {
      background: #2c2018 !important;
      color: #f0e4cc !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    thead th { padding: 6pt 8pt; font-size: 7pt; }
    tbody tr:nth-child(even) {
      background: #faf6f0 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    td { padding: 6pt 8pt; }
    td:first-child { font-size: 10pt; color: #b8965a !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .music-tag {
      background: #f0e4cc !important;
      color: #6b4f2e !important;
      font-size: 7.5pt;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Checkboxes op print: leeg hokje */
    .checklist li { font-size: 8pt; gap: 4pt; }
    .checklist li input[type="checkbox"] {
      width: 8pt; height: 8pt;
      border: 0.5pt solid #888 !important;
      background: white !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .checklist li input[type="checkbox"]:checked {
      background: #b8965a !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Paginabreuk na draaiboek */
    .break-after { break-after: page; }

    /* Benodigdheden 3 kolommen */
    .benodigdheden-grid { grid-template-columns: repeat(3, 1fr); gap: 8pt; }
    .benod-card { border: 0.5pt solid #ccc; padding: 8pt 10pt; break-inside: avoid; }
    .benod-card h3 { font-size: 11pt; margin-bottom: 6pt; padding-bottom: 5pt; }
    .benod-card ul li { font-size: 8pt; }

    /* Muziek 3 kolommen */
    .muziek-grid { grid-template-columns: repeat(3, 1fr); gap: 6pt; }
    .muziek-card { border: 0.5pt solid #ccc; padding: 7pt 9pt; break-inside: avoid; }
    .muziek-card .moment { font-size: 7pt; }
    .muziek-card .song { font-size: 8.5pt; }

    /* Spotify links */
    .playlist-links { gap: 5pt; }
    .playlist-link { border: 0.5pt solid #ccc; padding: 6pt 10pt; }
    .pl-name { font-size: 9pt; }
    .pl-url { font-size: 7.5pt; color: #555; word-break: break-all; }

    footer { padding: 12pt 0 4pt; }
    footer span { font-size: 12pt; }
  }

  /* ── DESIGN GRID ── */
  .design-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .design-card {
    background: var(--warm-white);
    border: 1px solid var(--border);
    overflow: hidden;
    break-inside: avoid;
  }
  .design-imgs {
    width: 100%;
  }
  .design-imgs.single img {
    width: 100%;
    height: auto;
    display: block;
  }
  .design-imgs.two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--border);
    align-items: start;
  }
  .design-imgs.two img {
    width: 100%;
    height: auto;
    display: block;
  }
  .design-label {
    padding: 10px 14px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--brown);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .design-label::before { content: '◆'; font-size: 6px; color: var(--gold); opacity: 0.6; }

  @media print {
    .design-grid { grid-template-columns: repeat(2, 1fr); gap: 8pt; }
    .design-imgs.single img { width: 100%; height: auto; }
    .design-imgs.two img { width: 100%; height: auto; }
    .design-label { font-size: 11pt; padding: 6pt 10pt; }
    .design-card { border: 0.5pt solid #ccc; }
  }

</style>
</head>
